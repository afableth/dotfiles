theme = Ayu
background-opacity = 1
background-blur-radius = 30

font-family = "HackGen Console NF"
font-size = 12

cursor-style = underline
cursor-style-blink = false

window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

mouse-hide-while-typing = true

keybind = ctrl+t>n=new_tab
keybind = ctrl+p>n=new_split:auto
keybind = ctrl+p>l=new_split:right
keybind = ctrl+p>h=new_split:left
keybind = ctrl+p>k=new_split:up
keybind = ctrl+p>j=new_split:down
keybind = ctrl+p>f=toggle_split_zoom
